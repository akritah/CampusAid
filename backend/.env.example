# Database Configuration
# Local-only default. Production must use a persistent PostgreSQL connection URL.
DATABASE_URL=sqlite:///./campusaid.db

# Enable SQL query logging only when debugging; keep disabled in production.
SQL_ECHO=False

# Application Settings
APP_ENV=development
SECRET_KEY=replace-with-a-random-value-of-at-least-32-characters
CORS_ORIGINS=http://localhost:3000
ALLOW_STAFF_REGISTRATION=false
# Optional. Set a JSON array of dedicated demo accounts; never use shared/default passwords.
# DEMO_USERS_JSON=[{"username":"faculty_demo","password":"set-a-unique-12+-character-password","role":"student"}]

# Optional persistent paths on Render (attach a disk mounted at /var/data).
POLICY_STORAGE_DIR=./policy_documents
HF_HOME=./.cache/huggingface
CLASSIFIER_MODEL_PATH=./models/complaint_classifier.pkl

# Speech-to-Text Settings
# Better accuracy models: small, medium, large
# (higher accuracy = slower inference)
WHISPER_MODEL=small
USE_FASTER_WHISPER=true
WHISPER_DECODE_PRESET=fast

# Optional general assistant for questions that do not match indexed policy text.
# Obtain a key from Google AI Studio; keep this only in the backend environment.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
